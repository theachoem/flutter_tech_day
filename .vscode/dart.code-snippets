    "prefix": "view",
    "body": [
      "import 'package:flutter/material.dart';",
      "import 'package:provider/provider.dart';",
      "",
      "import '${TM_FILENAME_BASE/_view/_view_model/}.dart';",
      "",
      "part '${TM_FILENAME_BASE/_view/_content/}.dart';",
      "",
      "",     
      "class ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/} extends StatelessWidget {",
      "  const ${TM_FILENAME_BASE/(.*)/${1:/pascalcase}/}({super.key});",
      "",
      "  @override",
      "  Widget build(BuildContext context) {",
      "    return ChangeNotifierProvider(",
      "      create: (context) => ${TM_FILENAME_BASE/(.*)_view/${1:/pascalcase}/}ViewModel(params: this),",
      "      builder: (context, child) {",
      "        final viewModel = Provider.of<${TM_FILENAME_BASE/(.*)_view/${1:/pascalcase}/}ViewModel>(context);",
      "        return _${TM_FILENAME_BASE/(.*)_view/${1:/pascalcase}/}Content(viewModel);",
